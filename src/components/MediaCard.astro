---
import type { MediaItem } from '../lib/types';
import { getImageUrl } from '../lib/tmdb';

interface Props {
  item: MediaItem;
}

const { item } = Astro.props;

const posterUrl = getImageUrl(item.poster_path, 'w500');
const year = item.release_date ? item.release_date.substring(0, 4) : '';
const watchUrl = item.imdb_id 
  ? `/watch?imdb=${item.imdb_id}`
  : `/watch?id=${item.id}&type=${item.media_type}`;
---

<a 
  href={watchUrl}
  class="group relative flex flex-col bg-[#141414] border border-[#222222] rounded-lg overflow-hidden transition-all duration-200 hover:border-neutral-500 hover:scale-[1.02] focus:outline-none focus:ring-1 focus:ring-neutral-400"
>
  <!-- Poster Container (2:3 aspect ratio, zero CLS) -->
  <div class="relative w-full aspect-[2/3] bg-neutral-900 overflow-hidden">
    <img
      src={posterUrl}
      alt={item.title}
      loading="lazy"
      decoding="async"
      width="300"
      height="450"
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
    
    <!-- Top overlay badges -->
    <div class="absolute top-2 left-2 right-2 flex items-center justify-between pointer-events-none gap-1">
      <span class="font-mono text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded bg-black/80 backdrop-blur-sm border border-neutral-800 text-neutral-300">
        {item.media_type === 'tv' ? 'SERIES' : 'MOVIE'}
      </span>

      {item.vote_average > 0 && (
        <span class="font-mono text-[11px] font-semibold px-1.5 py-0.5 rounded bg-black/80 backdrop-blur-sm border border-neutral-800 text-amber-400 flex items-center gap-1">
          <span>★</span>
          <span>{item.vote_average}</span>
        </span>
      )}
    </div>

    <!-- 4K / Quality indicator bottom right -->
    <div class="absolute bottom-2 right-2 pointer-events-none">
      <span class="font-mono text-[9px] font-bold px-1 py-0.5 rounded bg-black/80 border border-neutral-800 text-neutral-400">
        4K
      </span>
    </div>
  </div>

  <!-- Content metadata -->
  <div class="p-2.5 flex flex-col gap-1">
    <h3 class="font-sans text-xs font-semibold text-neutral-100 truncate group-hover:text-white" title={item.title}>
      {item.title}
    </h3>
    <div class="flex items-center justify-between text-[11px] font-mono text-neutral-500">
      <span>{year || '—'}</span>
      {item.imdb_id ? (
        <span class="text-neutral-400 font-mono text-[10px]">{item.imdb_id}</span>
      ) : (
        <span class="text-[10px]">TMDB {item.id}</span>
      )}
    </div>
  </div>
</a>
