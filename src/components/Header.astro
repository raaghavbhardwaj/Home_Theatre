---
// Zero-React Minimalist Header
import SearchDialog from './SearchDialog.astro';
const isHome = Astro.url.pathname === '/';
---

<header class="sticky top-0 z-40 bg-[#0e0e0e]/95 backdrop-blur border-b border-[#222222]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand -->
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2 group">
        <span class="font-mono text-sm tracking-wider font-bold text-white bg-neutral-900 border border-neutral-700 px-2 py-1 rounded transition-colors group-hover:border-neutral-500">
          HT
        </span>
        <span class="font-mono text-sm font-semibold tracking-tight text-neutral-200 group-hover:text-white transition-colors">
          HOME_THEATRE
        </span>
      </a>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-3">
      {!isHome && (
        <button
          id="search-open-btn"
          type="button"
          class="flex items-center gap-2.5 px-3 py-1.5 rounded-md bg-[#161616] border border-[#2a2a2a] hover:border-neutral-500 text-neutral-400 hover:text-white transition-all text-xs font-mono group cursor-pointer"
          aria-label="Open search dialog"
        >
          <svg class="w-3.5 h-3.5 text-neutral-500 group-hover:text-neutral-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline">Search...</span>
          <kbd class="px-1.5 py-0.5 text-[10px] bg-[#222222] border border-[#333333] rounded text-neutral-400 font-mono">
            /
          </kbd>
        </button>
      )}
      <a
        href="https://github.com/raaghavbhardwaj/Home_Theatre"
        target="_blank"
        rel="noopener noreferrer"
        class="text-neutral-500 hover:text-neutral-300 transition-colors p-1.5"
        title="GitHub Repository"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>
    </div>
  </div>
</header>

{!isHome && <SearchDialog />}
