---
interface Props {
  id: number | string;
  imdbId?: string;
  mediaType: 'movie' | 'tv';
  season?: number;
  episode?: number;
  title: string;
}

const {
  id,
  imdbId = '',
  mediaType,
  season = 1,
  episode = 1,
  title,
} = Astro.props;

const isTv = mediaType === 'tv';
---

<div class="flex flex-col gap-3 w-full" id="player-wrapper">
  <!-- Status Header -->
  <div class="flex flex-wrap items-center justify-between gap-2 px-1 py-1 font-mono text-xs">
    <div class="flex items-center gap-2">
      <span class="text-neutral-500 font-semibold uppercase text-[11px] flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-neutral-600"></span>
        STREAM STATUS:
      </span>
      <span class="text-neutral-400 text-xs">No active providers</span>
    </div>
  </div>

  <!-- Theater Player Container (Clean Placeholder) -->
  <div class="relative w-full aspect-video bg-[#0a0a0a] rounded-xl overflow-hidden border border-[#222222] shadow-2xl flex flex-col items-center justify-center p-6 text-center">
    <div class="w-14 h-14 rounded-full bg-neutral-900 border border-neutral-800 flex items-center justify-center mb-4 text-neutral-500">
      <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
    </div>
    <h3 class="text-lg font-bold text-white mb-1">{title}</h3>
    <p class="text-neutral-400 text-sm max-w-md mb-4 font-sans">
      {isTv ? `Season ${season} Episode ${episode}` : 'Movie'} stream providers have been removed.
    </p>
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded bg-neutral-900 border border-neutral-800 font-mono text-xs text-neutral-400">
      <span>Ready for new streaming integration</span>
    </div>
  </div>
</div>
