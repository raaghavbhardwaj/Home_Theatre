---
interface Props {
  id: number | string;
  imdbId?: string;
  mediaType: 'movie' | 'tv';
  season?: number;
  episode?: number;
  title: string;
}

const {
  id,
  imdbId = '',
  mediaType,
  season = 1,
  episode = 1,
  title,
} = Astro.props;

const isTv = mediaType === 'tv';
const apiUrl = `/api/streams?id=${id}&type=${mediaType}${isTv ? `&season=${season}&episode=${episode}` : ''}`;
---

<div class="flex flex-col gap-3 w-full" id="player-wrapper" data-api={apiUrl} data-title={title}>
  <!-- Controls & Quality Switcher Bar -->
  <div class="flex flex-wrap items-center justify-between gap-2 px-1 py-1 font-mono text-xs">
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="text-neutral-500 font-semibold uppercase text-[11px] flex items-center gap-1.5">
          <span id="player-dot" class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
          <span id="player-status-text">RESOLVING STREAMS:</span>
        </span>
        <div id="quality-selector" class="flex flex-wrap items-center gap-1.5">
          <!-- Injected dynamically via client script -->
        </div>
      </div>

      <!-- Subtitles Selector -->
      <div id="subtitle-control" class="hidden items-center gap-1.5 font-mono text-xs">
        <span class="text-neutral-500 font-semibold uppercase text-[11px] flex items-center gap-1">
          <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="M7 15h4M15 15h2M7 11h2M13 11h4"></path>
          </svg>
          CC:
        </span>
        <select
          id="subtitle-select"
          aria-label="Select subtitles"
          class="bg-neutral-900 text-neutral-300 border border-neutral-800 rounded px-2 py-0.5 text-xs font-mono focus:outline-none focus:border-neutral-500 cursor-pointer hover:text-white transition-colors max-w-[160px] sm:max-w-[220px] truncate"
        >
          <option value="off">Off</option>
        </select>
      </div>
    </div>

    <div class="flex items-center gap-3 text-neutral-400 text-[11px]">
      <span id="active-stream-badge" class="font-medium text-white">Stream</span>
      <span class="text-neutral-700">|</span>
      <a
        id="external-stream-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden hover:text-white transition-colors underline flex items-center gap-1"
      >
        <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
        External / VLC Link
      </a>
    </div>
  </div>

  <!-- Theater Player Container -->
  <div class="relative w-full aspect-video bg-black rounded-xl border border-[#222222] shadow-2xl flex items-center justify-center overflow-hidden">
    <!-- Loading Overlay -->
    <div id="stream-loading" class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-black/90 p-6 text-center">
      <div class="w-10 h-10 border-2 border-neutral-700 border-t-white rounded-full animate-spin mb-3"></div>
      <p class="text-white font-medium text-sm mb-1">Searching for streams…</p>
      <p class="text-neutral-500 text-xs font-mono max-w-sm">Resolving media streams</p>
    </div>

    <!-- Error / Empty State Overlay -->
    <div id="stream-empty" class="hidden absolute inset-0 z-20 flex flex-col items-center justify-center bg-[#0d0d0d] p-6 text-center">
      <div class="w-12 h-12 rounded-full bg-neutral-900 border border-neutral-800 flex items-center justify-center mb-3 text-neutral-500">
        <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="15" y1="9" x2="9" y2="15"></line>
          <line x1="9" y1="9" x2="15" y2="15"></line>
        </svg>
      </div>
      <h3 class="text-white font-bold text-sm mb-1">No streams currently configured</h3>
      <p class="text-neutral-400 text-xs max-w-md mb-4 font-sans">
        Waiting for stream provider configuration.
      </p>
    </div>

    <!-- Playback Error / Codec Fallback Overlay -->
    <div id="stream-playback-error" class="hidden absolute inset-0 z-20 flex flex-col items-center justify-center bg-[#0d0d0d]/95 p-6 text-center">
      <div class="w-12 h-12 rounded-full bg-amber-950/40 border border-amber-800/60 flex items-center justify-center mb-3 text-amber-500">
        <svg class="w-6 h-6 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <h3 class="text-white font-bold text-sm mb-1">Browser Playback Notice</h3>
      <p class="text-neutral-400 text-xs max-w-md mb-4 font-sans leading-relaxed">
        Your browser could not decode this stream format or audio codec (e.g. MKV/EAC3/DTS). Try another quality or open the stream in VLC / MPV.
      </p>
      <div class="flex items-center gap-3">
        <a
          id="error-external-btn"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded bg-white text-black font-semibold text-xs font-mono hover:bg-neutral-200 transition-colors"
        >
          Open in VLC / MPV
        </a>
        <button
          id="error-retry-btn"
          type="button"
          class="px-4 py-2 rounded bg-neutral-900 border border-neutral-700 text-neutral-300 font-mono text-xs hover:border-neutral-500 transition-colors cursor-pointer"
        >
          Try Next Stream
        </button>
      </div>
    </div>

    <!-- Native HTML5 Video Element with CORS anonymous for WebVTT tracks -->
    <video
      id="main-video"
      controls
      playsinline
      crossorigin="anonymous"
      preload="metadata"
      aria-label={`Video player for ${title}`}
      class="w-full h-full object-contain"
    >
      Your browser does not support the video tag.
    </video>
  </div>
</div>

<script>
  interface SubtitleItem {
    url: string;
    language: string;
    name: string;
  }

  interface StreamItem {
    name: string;
    title: string;
    url: string;
    quality: string;
    size?: string;
    format?: string;
    subtitles?: SubtitleItem[];
  }

  const wrapper = document.getElementById('player-wrapper');
  const video = document.getElementById('main-video') as HTMLVideoElement | null;
  const loadingOverlay = document.getElementById('stream-loading');
  const emptyOverlay = document.getElementById('stream-empty');
  const errorOverlay = document.getElementById('stream-playback-error');
  const errorExternalBtn = document.getElementById('error-external-btn') as HTMLAnchorElement | null;
  const errorRetryBtn = document.getElementById('error-retry-btn') as HTMLButtonElement | null;
  const qualitySelector = document.getElementById('quality-selector');
  const subtitleControl = document.getElementById('subtitle-control');
  const subtitleSelect = document.getElementById('subtitle-select') as HTMLSelectElement | null;
  const playerDot = document.getElementById('player-dot');
  const statusText = document.getElementById('player-status-text');
  const activeBadge = document.getElementById('active-stream-badge');
  const externalLink = document.getElementById('external-stream-link') as HTMLAnchorElement | null;

  interface HlsInstance {
    destroy(): void;
    loadSource(url: string): void;
    attachMedia(media: HTMLMediaElement): void;
    on(event: string, callback: (event: string, data: { fatal?: boolean }) => void): void;
  }

  interface HlsConstructor {
    new (config?: Record<string, unknown>): HlsInstance;
    isSupported(): boolean;
    Events: { ERROR: string };
  }

  interface WindowWithHls extends Window {
    Hls?: HlsConstructor;
  }

  let currentStreams: StreamItem[] = [];
  let currentIdx = 0;
  let hlsInstance: HlsInstance | null = null;
  let currentBlobUrls: string[] = [];

  function showPlaybackError(stream: StreamItem) {
    if (errorOverlay) errorOverlay.classList.remove('hidden');
    if (errorExternalBtn) errorExternalBtn.href = stream.url;
    if (playerDot) playerDot.className = 'w-2 h-2 rounded-full bg-amber-500';
    if (statusText) statusText.textContent = 'CODEC / PLAYBACK NOTICE:';
  }

  function hidePlaybackError() {
    if (errorOverlay) errorOverlay.classList.add('hidden');
  }

  function cleanupHls() {
    if (hlsInstance) {
      try {
        hlsInstance.destroy();
      } catch {}
      hlsInstance = null;
    }
  }

  function cleanupSubtitles() {
    for (const url of currentBlobUrls) {
      URL.revokeObjectURL(url);
    }
    currentBlobUrls = [];
    if (video) {
      const tracks = video.querySelectorAll('track');
      tracks.forEach((t) => t.remove());
    }
  }

  function srtToVtt(srtText: string): string {
    let vtt = srtText.replace(/^\uFEFF/, '').replace(/\r\n|\r/g, '\n').trim();
    if (vtt.startsWith('WEBVTT')) return vtt;
    vtt = vtt.replace(/(\d{2}:\d{2}:\d{2}),(\d{3})/g, '$1.$2');
    return `WEBVTT\n\n${vtt}\n`;
  }

  function setupSubtitles(subtitles?: SubtitleItem[]) {
    if (!video || !subtitleControl || !subtitleSelect) return;
    cleanupSubtitles();

    if (!Array.isArray(subtitles) || subtitles.length === 0) {
      subtitleControl.classList.add('hidden');
      subtitleControl.classList.remove('flex');
      return;
    }

    subtitleSelect.innerHTML = '<option value="off">Off</option>';

    subtitles.forEach((sub, idx) => {
      const opt = document.createElement('option');
      opt.value = String(idx);
      opt.textContent = sub.name || sub.language.toUpperCase();
      subtitleSelect.appendChild(opt);

      // Create native HTML5 track element pointing to WebVTT edge proxy
      const track = document.createElement('track');
      track.kind = 'subtitles';
      track.label = sub.name || sub.language || 'Subtitles';
      track.srclang = sub.language || 'en';
      track.src = `/api/subtitles?url=${encodeURIComponent(sub.url)}`;

      // Client-side fallback: If edge proxy request is interrupted, fetch directly and convert via Blob URL
      track.onerror = async () => {
        try {
          const res = await fetch(sub.url);
          if (res.ok) {
            const raw = await res.text();
            const vtt = srtToVtt(raw);
            const blob = new Blob([vtt], { type: 'text/vtt' });
            const blobUrl = URL.createObjectURL(blob);
            currentBlobUrls.push(blobUrl);
            track.src = blobUrl;
          }
        } catch {
          // ignore
        }
      };

      video.appendChild(track);
    });

    subtitleControl.classList.remove('hidden');
    subtitleControl.classList.add('flex');
  }

  function switchSubtitle(selectedIndex: number | 'off') {
    if (!video) return;
    const tracks = video.textTracks;

    for (let i = 0; i < tracks.length; i++) {
      if (selectedIndex !== 'off' && i === selectedIndex) {
        tracks[i].mode = 'showing';
      } else {
        tracks[i].mode = 'disabled';
      }
    }

    if (subtitleSelect) {
      subtitleSelect.value = String(selectedIndex);
    }
  }

  subtitleSelect?.addEventListener('change', () => {
    if (!subtitleSelect) return;
    const val = subtitleSelect.value;
    if (val === 'off') {
      switchSubtitle('off');
    } else {
      switchSubtitle(parseInt(val, 10));
    }
  });

  // Sync state when user changes subtitles via browser's native [CC] button
  if (video && video.textTracks) {
    video.textTracks.addEventListener('change', () => {
      if (!video || !subtitleSelect) return;
      const tracks = video.textTracks;
      let activeIdx: number | 'off' = 'off';
      for (let i = 0; i < tracks.length; i++) {
        if (tracks[i].mode === 'showing') {
          activeIdx = i;
          break;
        }
      }
      subtitleSelect.value = String(activeIdx);
    });
  }

  function loadHlsScript(): Promise<void> {
    const win = window as unknown as WindowWithHls;
    if (win.Hls) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/hls.js@1.5.8/dist/hls.min.js';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('Failed to load HLS engine'));
      document.head.appendChild(script);
    });
  }

  async function applyStream(stream: StreamItem) {
    if (!video) return;
    hidePlaybackError();
    cleanupHls();

    // Populate subtitle tracks
    setupSubtitles(stream.subtitles);

    const isHls = stream.format === 'm3u8' || stream.url.includes('.m3u8');

    if (isHls && !video.canPlayType('application/vnd.apple.mpegurl')) {
      try {
        await loadHlsScript();
        const win = window as unknown as WindowWithHls;
        const Hls = win.Hls;
        if (Hls && Hls.isSupported()) {
          hlsInstance = new Hls({ enableWorker: true });
          hlsInstance.loadSource(stream.url);
          hlsInstance.attachMedia(video);
          hlsInstance.on(Hls.Events.ERROR, (_event, data) => {
            if (data.fatal) {
              showPlaybackError(stream);
            }
          });
          return;
        }
      } catch {
        // Fall back to direct video.src
      }
    }

    video.src = stream.url;
    video.load();
  }

  function selectStreamByIndex(index: number) {
    if (!currentStreams.length || index < 0 || index >= currentStreams.length) return;
    currentIdx = index;
    const stream = currentStreams[currentIdx];

    applyStream(stream);

    if (activeBadge) {
      activeBadge.textContent = stream.size ? `${stream.quality} (${stream.size})` : stream.quality;
    }

    if (externalLink) {
      externalLink.href = stream.url;
      externalLink.classList.remove('hidden');
    }

    const buttons = qualitySelector?.querySelectorAll('button') || [];
    buttons.forEach((b, idx) => {
      if (idx === currentIdx) {
        b.className = 'px-2.5 py-1 rounded text-xs transition-colors cursor-pointer bg-white text-black font-semibold';
      } else {
        b.className = 'px-2.5 py-1 rounded text-xs transition-colors cursor-pointer bg-neutral-900 text-neutral-400 hover:text-white border border-neutral-800';
      }
    });
  }

  errorRetryBtn?.addEventListener('click', () => {
    if (currentStreams.length > 1) {
      selectStreamByIndex((currentIdx + 1) % currentStreams.length);
    }
  });

  video?.addEventListener('error', () => {
    if (currentStreams[currentIdx]) {
      showPlaybackError(currentStreams[currentIdx]);
    }
  });

  async function initPlayer() {
    if (!wrapper || !video) return;
    const apiUrl = wrapper.dataset.api;
    if (!apiUrl) return;

    try {
      const res = await fetch(apiUrl);
      if (!res.ok) throw new Error('API failed');
      const data = await res.json();
      currentStreams = data.streams || [];

      if (currentStreams.length === 0) {
        if (loadingOverlay) loadingOverlay.style.display = 'none';
        if (emptyOverlay) emptyOverlay.classList.remove('hidden');
        if (playerDot) playerDot.className = 'w-2 h-2 rounded-full bg-neutral-600';
        if (statusText) statusText.textContent = 'STREAMS: UNAVAILABLE';
        return;
      }

      // Streams found
      if (loadingOverlay) loadingOverlay.style.display = 'none';
      if (playerDot) playerDot.className = 'w-2 h-2 rounded-full bg-emerald-500';
      if (statusText) statusText.textContent = 'AVAILABLE STREAMS:';

      // Count occurrences to label duplicate qualities cleanly
      const qualityCounts = new Map<string, number>();
      currentStreams.forEach((s) => {
        qualityCounts.set(s.quality, (qualityCounts.get(s.quality) || 0) + 1);
      });
      const qualitySeen = new Map<string, number>();

      // Populate quality switcher buttons
      if (qualitySelector) {
        qualitySelector.innerHTML = '';
        currentStreams.forEach((s, idx) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          const count = qualityCounts.get(s.quality) || 1;
          const seen = (qualitySeen.get(s.quality) || 0) + 1;
          qualitySeen.set(s.quality, seen);
          const suffix = count > 1 ? ` #${seen}` : '';
          const label = s.size ? `${s.quality}${suffix} [${s.size}]` : `${s.quality}${suffix}`;
          btn.textContent = label;
          btn.className = idx === 0
            ? 'px-2.5 py-1 rounded text-xs transition-colors cursor-pointer bg-white text-black font-semibold'
            : 'px-2.5 py-1 rounded text-xs transition-colors cursor-pointer bg-neutral-900 text-neutral-400 hover:text-white border border-neutral-800';
          
          btn.addEventListener('click', () => selectStreamByIndex(idx));
          qualitySelector.appendChild(btn);
        });
      }

      // Load first stream
      selectStreamByIndex(0);

    } catch (err) {
      if (loadingOverlay) loadingOverlay.style.display = 'none';
      if (emptyOverlay) emptyOverlay.classList.remove('hidden');
      if (playerDot) playerDot.className = 'w-2 h-2 rounded-full bg-red-500';
      if (statusText) statusText.textContent = 'STREAMS: ERROR';
    }
  }

  // Keyboard Shortcuts for video player
  window.addEventListener('keydown', (e) => {
    if (!video) return;
    const active = document.activeElement;
    if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT')) return;

    if (e.code === 'Space') {
      e.preventDefault();
      if (video.paused) video.play();
      else video.pause();
    } else if (e.key === 'f' || e.key === 'F') {
      e.preventDefault();
      if (!document.fullscreenElement) {
        video.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    } else if (e.key === 'm' || e.key === 'M') {
      video.muted = !video.muted;
    } else if (e.code === 'ArrowRight') {
      video.currentTime = Math.min(video.duration || 0, video.currentTime + 10);
    } else if (e.code === 'ArrowLeft') {
      video.currentTime = Math.max(0, video.currentTime - 10);
    }
  });

  initPlayer();
</script>

<style>
  video::cue {
    background-color: rgba(0, 0, 0, 0.85);
    color: #ffffff;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 1.1rem;
    line-height: 1.4;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
    padding: 0.2em 0.5em;
    border-radius: 4px;
  }
</style>
