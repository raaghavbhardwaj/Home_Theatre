---
import Layout from '../layouts/Layout.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import EpisodePicker from '../components/EpisodePicker.astro';
import { getMediaDetails, getSeasonEpisodes, resolveByImdbId } from '../lib/tmdb';
import type { Episode, MediaDetails } from '../lib/types';

const imdbParam = Astro.url.searchParams.get('imdb');
const idParam = Astro.url.searchParams.get('id');
const typeParam = (Astro.url.searchParams.get('type') || 'movie') as 'movie' | 'tv';
const seasonParam = parseInt(Astro.url.searchParams.get('season') || '1', 10);
const episodeParam = parseInt(Astro.url.searchParams.get('episode') || '1', 10);

let mediaId: number | string | null = idParam;
let mediaType: 'movie' | 'tv' = typeParam;
let imdbId: string | undefined = imdbParam || undefined;

// If IMDb ID was provided without TMDB ID, resolve it
if (imdbParam && !idParam) {
  const resolved = await resolveByImdbId(imdbParam);
  if (resolved) {
    mediaId = resolved.id;
    mediaType = resolved.media_type;
    imdbId = imdbParam;
  }
}

if (!mediaId) {
  return Astro.redirect('/');
}

// Fetch media details
const details: MediaDetails | null = await getMediaDetails(mediaId, mediaType);

if (!details) {
  return Astro.redirect('/');
}

if (!imdbId && details.imdb_id) {
  imdbId = details.imdb_id;
}

// If TV, fetch season episodes
let episodes: Episode[] = [];
if (mediaType === 'tv') {
  episodes = await getSeasonEpisodes(details.id, seasonParam);
}


const currentEpisodeTitle = mediaType === 'tv' 
  ? episodes.find((e) => e.episode_number === episodeParam)?.name 
  : null;

const pageTitle = mediaType === 'tv'
  ? `Watch ${details.title} S${String(seasonParam).padStart(2, '0')}E${String(episodeParam).padStart(2, '0')} — HOME_THEATRE`
  : `Watch ${details.title} — HOME_THEATRE`;

const year = details.release_date ? details.release_date.substring(0, 4) : '';
---

<Layout title={pageTitle} description={details.overview}>
  <div class="flex flex-col gap-6 max-w-6xl mx-auto">
    <!-- Breadcrumb / Header bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 text-xs font-mono border-b border-[#222222] pb-3">
      <div class="flex items-center gap-2 text-neutral-400">
        <a href="/" class="hover:text-white transition-colors">HOME</a>
        <span>/</span>
        <a href={`/?type=${mediaType}`} class="hover:text-white transition-colors uppercase">{mediaType}</a>
        <span>/</span>
        <span class="text-white font-semibold">{details.title}</span>
        {mediaType === 'tv' && (
          <span class="text-neutral-400">
            [S{seasonParam}E{episodeParam}{currentEpisodeTitle ? ` — ${currentEpisodeTitle}` : ''}]
          </span>
        )}
      </div>

      <div class="flex items-center gap-3">
        {imdbId && (
          <a
            href={`https://www.imdb.com/title/${imdbId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1 rounded bg-[#1a1a1a] border border-[#333333] text-amber-400 hover:border-neutral-400 transition-colors flex items-center gap-1.5"
          >
            <span class="font-bold">IMDb</span>
            <span>{imdbId}</span>
          </a>
        )}
        <a
          href={`https://www.themoviedb.org/${mediaType}/${details.id}`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-2.5 py-1 rounded bg-[#1a1a1a] border border-[#333333] text-neutral-400 hover:text-white transition-colors"
        >
          TMDB {details.id}
        </a>
      </div>
    </div>

    <!-- Video Player Island -->
    <VideoPlayer
      id={details.id}
      imdbId={imdbId}
      mediaType={mediaType}
      season={seasonParam}
      episode={episodeParam}
      title={details.title}
    />

    <!-- TV Episode Picker (if series) -->
    {mediaType === 'tv' && details.seasons && details.seasons.length > 0 && (
      <EpisodePicker
        mediaId={details.id}
        imdbId={imdbId}
        seasons={details.seasons}
        currentSeason={seasonParam}
        currentEpisode={episodeParam}
        episodes={episodes}
      />
    )}

    <!-- Media Metadata Section -->
    <div class="flex flex-col md:flex-row gap-6 bg-[#121212] border border-[#222222] rounded-lg p-6">
      {details.poster_path && (
        <img
          src={`https://image.tmdb.org/t/p/w300${details.poster_path}`}
          alt={details.title}
          class="w-32 sm:w-40 h-auto rounded-md object-cover border border-[#262626] shrink-0 self-start shadow-md"
          loading="lazy"
        />
      )}

      <div class="flex-1 flex flex-col gap-4">
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <h1 class="text-xl sm:text-2xl font-bold font-sans text-white">
              {details.title}
            </h1>
            {year && <span class="font-mono text-sm text-neutral-500">({year})</span>}
          </div>

          <!-- Badges -->
          <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
            {details.vote_average > 0 && (
              <span class="px-2 py-0.5 rounded bg-black border border-neutral-800 text-amber-400 font-semibold">
                ★ {details.vote_average} / 10
              </span>
            )}
            {details.runtime && (
              <span class="px-2 py-0.5 rounded bg-[#181818] border border-neutral-800 text-neutral-400">
                {Math.floor(details.runtime / 60)}h {details.runtime % 60}m
              </span>
            )}
            {details.number_of_seasons && (
              <span class="px-2 py-0.5 rounded bg-[#181818] border border-neutral-800 text-neutral-400">
                {details.number_of_seasons} {details.number_of_seasons === 1 ? 'Season' : 'Seasons'}
              </span>
            )}
            {details.genres.map((g) => (
              <a
                href={`/?genre=${g.id}&type=${mediaType}`}
                class="px-2 py-0.5 rounded bg-[#181818] border border-neutral-800 text-neutral-400 hover:text-white transition-colors"
              >
                {g.name}
              </a>
            ))}
            {details.trailer_key && (
              <a
                href={`https://www.youtube.com/watch?v=${details.trailer_key}`}
                target="_blank"
                rel="noopener noreferrer"
                class="px-2.5 py-0.5 rounded bg-red-950/50 border border-red-800 text-red-300 hover:bg-red-900/60 transition-colors flex items-center gap-1 font-semibold"
              >
                <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24">
                  <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
                </svg>
                Trailer
              </a>
            )}
          </div>
        </div>

        {details.overview && (
          <p class="text-neutral-300 text-sm leading-relaxed font-sans">
            {details.overview}
          </p>
        )}

        <!-- Top Cast -->
        {details.cast && details.cast.length > 0 && (
          <div class="mt-2 border-t border-[#222222] pt-4">
            <span class="font-mono text-xs uppercase font-bold text-neutral-400 block mb-2">TOP CAST:</span>
            <div class="flex flex-wrap gap-2">
              {details.cast.map((c) => (
                <div class="flex items-center gap-2 bg-[#181818] border border-[#262626] rounded px-2 py-1">
                  {c.profile_path ? (
                    <img
                      src={`https://image.tmdb.org/t/p/w45${c.profile_path}`}
                      alt={c.name}
                      class="w-5 h-5 rounded-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-5 h-5 rounded-full bg-neutral-800 flex items-center justify-center text-[9px] font-mono text-neutral-400">
                      {c.name.charAt(0)}
                    </div>
                  )}
                  <div class="text-xs">
                    <span class="text-neutral-200 font-medium">{c.name}</span>
                    <span class="text-neutral-500 font-mono text-[11px] ml-1">({c.character})</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
